{
	"name": "@feedbakkr/watch-types",
	"version": "0.2.3",
	"description": "Shared types for the Feedbakkr Watch tool contract (manifest, connection, report shapes, project stats, notifications).",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"devDependencies": {
		"tsup": "^8.3.0",
		"typescript": "~5.8.0",
		"vitest": "^3.0.0"
	}
}
