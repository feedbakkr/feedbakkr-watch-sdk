{
	"name": "@feedbakkr/watch-node",
	"version": "1.0.0",
	"description": "Send server errors (Node, Cloudflare Workers, Hono) to FeedBakkr Watch.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feedbakkr/feedbakkr-watch-sdk.git",
		"directory": "packages/watch-node"
	},
	"homepage": "https://github.com/feedbakkr/feedbakkr-watch-sdk/tree/main/packages/watch-node#readme",
	"bugs": "https://github.com/feedbakkr/feedbakkr-watch-sdk/issues",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./hono": {
			"types": "./dist/hono.d.ts",
			"import": "./dist/hono.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup src/index.ts src/hono.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts src/hono.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"peerDependencies": {
		"hono": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"hono": {
			"optional": true
		}
	},
	"dependencies": {
		"@feedbakkr/watch-core": "workspace:^"
	},
	"devDependencies": {
		"hono": "^4.13.13",
		"tsup": "^9.0.0",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	}
}
