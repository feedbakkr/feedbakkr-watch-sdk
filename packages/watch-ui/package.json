{
	"name": "@feedbakkr/watch-ui",
	"version": "0.2.3",
	"description": "React components for browsing and acting on errors collected by a Feedbakkr Watch worker.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"dependencies": {
		"@feedbakkr/watch-types": "workspace:^"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"react": "^19.0.0",
		"tsup": "^8.3.0",
		"typescript": "~5.8.0",
		"vitest": "^3.0.0"
	}
}
